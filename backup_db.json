[{"workspaceId":1,"type":"skill","title":"Маркетинг","createdAt":1784889484608,"script":"Workspace.log(\"🤖 Запуск сценария генерации спринта...\");\n\nconst projectName = \"Маркетинг\";\n\n// 1. Создаем корневую задачу\nconst rootRes = await Workspace.callTool(\"add_task_to_project\", {\n  projectTitle: projectName,\n  taskTitle: \"Запустить рекламу в соцсетях\"\n});\nWorkspace.log(rootRes);\n\nif (rootRes.status === \"success\") {\n  const rootId = rootRes.task.id;\n\n  // 2. Создаем вложенную подзадачу первого уровня, передавая parentId\n  const subRes1 = await Workspace.callTool(\"add_task_to_project\", {\n    projectTitle: projectName,\n    taskTitle: \"Подготовить графические креативы\",\n    parentId: rootId\n  });\n  Workspace.log(subRes1);\n\n  // 3. Создаем еще одну подзадачу\n  const subRes2 = await Workspace.callTool(\"add_task_to_project\", {\n    projectTitle: projectName,\n    taskTitle: \"Согласовать бюджет\",\n    parentId: rootId\n  });\n  Workspace.log(subRes2);\n  \n  // 4. Допустим, бюджет согласовали мгновенно — робот сам ставит чекбокс!\n  if (subRes2.status === \"success\") {\n     const updateRes = await Workspace.callTool(\"update_task_status\", {\n       projectTitle: projectName,\n       taskId: subRes2.task.id,\n       done: true\n     });\n     Workspace.log(updateRes);\n  }\n}\n\n","id":9},{"workspaceId":1,"type":"project","title":"Маркетинг","createdAt":1784889720989,"tasks":[{"id":"5d73f389-eabb-45b5-b0e0-b6ba49550402","title":"Запустить рекламу в соцсетях","done":false,"subtasks":[{"id":"c972eb4d-772a-4df7-890c-3d02b5e73f15","title":"Подготовить графические креативы","done":false,"subtasks":[]}]}],"id":10},{"workspaceId":1,"type":"note","title":"google AI разработка этого проекта","createdAt":1784892071062,"content":"https://share.google/aimode/hTh5etTkLdxYOiURD","id":11},{"workspaceId":1,"type":"skill","title":"Новый робот","createdAt":1784892150225,"script":"","id":12},{"workspaceId":1,"type":"note","title":"Убить и запустить проек